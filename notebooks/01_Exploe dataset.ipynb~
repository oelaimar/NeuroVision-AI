    "        RAW_DIR.parent.mkdir(parents=True, exist_ok=True)\n",
    "        shutil.move(str(source_dir), str(RAW_DIR))\n",
    "\n",
    "        if not has_classes(RAW_DIR):\n",
    "            raise RuntimeError(\"Dataset validation failed after moving.\")\n",

    "            ),\n",
    "            None,\n",
    "        )\n",
    "\n",
    "        if source_dir is None or not has_classes(source_dir):\n",
    "            raise FileNotFoundError(\n",
    "                \"Could not find all four valid class folders \"\n",
    "                \"with images in the ZIP.\"\n",
    "            )\n",

    "    shutil.rmtree(REPO_TMP, ignore_errors=True)\n",
    "    REPO_TMP.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    try:\n",
    "        with urllib.request.urlopen(REPO_ZIP_URL, timeout=60) as response:\n",
    "            REPO_ZIP.write_bytes(response.read())\n",

    "SRC_DIR = BASE_DIR / \"src\"\n",
    "\n",
    "FILE_ID = \"1p7R-87Embk8yJq35tkcJDpJ0f72m8-bs\"\n",
    "ZIP_PATH = BASE_DIR / \"data.zip\"\n",
    "TMP_DIR = BASE_DIR / \"tmp_unzip\"\n",
